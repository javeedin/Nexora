{
  "name": "@nexora/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared lint, format, TypeScript and commit-message config for every Nexora TS workspace",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./commitlint": "./commitlint.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react.json": "./tsconfig/react.json"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10",
    "prettier": "^3",
    "typescript": "^6"
  },
  "devDependencies": {
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
