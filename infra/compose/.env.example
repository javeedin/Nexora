# Copied to .env by `make up` (scripts/dev-env.mjs); every `generate` value becomes a random per-machine secret.
# .env is gitignored. These are local-dev credentials only — real secrets live in Vault (rule 3).
ORACLE_PASSWORD=generate
ORACLE_APP_PASSWORD=generate
KEYCLOAK_ADMIN_PASSWORD=generate
NEXORA_DEV_USER_PASSWORD=generate
REDIS_PASSWORD=generate
S3_ACCESS_KEY=generate
S3_SECRET_KEY=generate
VAULT_ROOT_TOKEN=generate
# Demo tenants seeded into Vault (must match Keycloak organisations)
SEED_TENANTS=acme,globex
