{
  "realm": "nexora",
  "displayName": "Nexora (local dev)",
  "enabled": true,
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Vendor console (PC-14)"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant admin console (PC-13)"
      },
      {
        "name": "user",
        "description": "Regular tenant user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nexora-web",
      "name": "Nexora web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "acr.loa.map": "{\"pwd\": 1, \"mfa\": 2}"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "email", "roles", "organization"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenants (organisations with id)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "tenants",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationId": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience nexora-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexora-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nexora-dev-cli",
      "name": "Dev / test token client (password grant, local only)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "email", "roles", "organization"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenants (organisations with id)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "tenants",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationId": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience nexora-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexora-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nexora-api",
      "name": "Nexora API (resource server + admin service account)",
      "publicClient": false,
      "secret": "${NEXORA_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"]
    }
  ],
  "users": [
    {
      "username": "admin@acme.test",
      "email": "admin@acme.test",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${NEXORA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["tenant-admin", "user"]
    },
    {
      "username": "user@globex.test",
      "email": "user@globex.test",
      "emailVerified": true,
      "firstName": "Gus",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${NEXORA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "vendor@nexora.test",
      "email": "vendor@nexora.test",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Vendor",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${NEXORA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["platform-admin"]
    },
    {
      "username": "service-account-nexora-api",
      "enabled": true,
      "serviceAccountClientId": "nexora-api",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "manage-realm"]
      }
    }
  ],
  "organizations": [
    {
      "name": "Acme",
      "alias": "acme",
      "enabled": true,
      "domains": [
        {
          "name": "acme.test",
          "verified": true
        }
      ],
      "members": [
        {
          "username": "admin@acme.test",
          "membershipType": "MANAGED"
        }
      ]
    },
    {
      "name": "Globex",
      "alias": "globex",
      "enabled": true,
      "domains": [
        {
          "name": "globex.test",
          "verified": true
        }
      ],
      "members": [
        {
          "username": "user@globex.test",
          "membershipType": "MANAGED"
        }
      ]
    }
  ],
  "loginTheme": "nexora",
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@nexora.test",
    "fromDisplayName": "Nexora"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "attributes": {
    "acr.loa.map": "{\"pwd\": 1, \"mfa\": 2}"
  },
  "browserFlow": "browser-step-up",
  "authenticationFlows": [
    {
      "alias": "browser-step-up",
      "description": "Cookie, or password (LoA 1) then OTP when mfa (LoA 2) is requested",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "step-up-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "step-up-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "step-up-level-1",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "step-up-level-2",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "step-up-level-1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa-1",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "step-up-level-2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa-2",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "300"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    }
  ]
}
