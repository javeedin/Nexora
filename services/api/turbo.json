{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["**/*.cs", "**/*.csproj", "**/*.json"]
    },
    "lint": {
      "dependsOn": ["test"],
      "inputs": ["**/*.cs", "**/*.csproj"]
    }
  }
}
